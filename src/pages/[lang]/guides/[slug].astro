---
import { getCollection, render } from 'astro:content'
import Base from '@/layouts/Base.astro'
import { getDict, localizePath, isLocale, type Locale } from '@/i18n'

export async function getStaticPaths() {
  const guides = await getCollection('guides')
  return guides.map((entry) => {
    const [lang, ...rest] = entry.id.split('/')
    return { params: { lang, slug: rest.join('/') }, props: { entry } }
  })
}

const { entry } = Astro.props
const lang = Astro.params.lang
const locale: Locale = isLocale(lang) ? lang : 'en'
const dict = getDict(locale)
const { Content } = await render(entry)
---

<Base locale={locale} title={entry.data.title} description={entry.data.description}>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <a
      href={localizePath('/guides', locale)}
      class="text-sm text-primary underline-offset-4 hover:underline"
    >
      ← {dict.guides.backToGuides}
    </a>
    <h1 class="mt-4 font-display text-3xl font-semibold leading-tight sm:text-4xl">
      {entry.data.title}
    </h1>
    <p class="mt-3 text-lg text-muted-foreground">{entry.data.description}</p>
    <div
      class="prose-custom mt-10 flex flex-col gap-5 leading-relaxed [&_h2]:font-display [&_h2]:mt-4 [&_h2]:text-xl [&_h2]:font-semibold [&_h3]:font-medium [&_h3]:mt-2 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:flex [&_ul]:flex-col [&_ul]:gap-1.5 [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:flex [&_ol]:flex-col [&_ol]:gap-1.5 [&_p]:text-foreground/85 [&_li]:text-foreground/85 [&_strong]:text-foreground [&_a]:text-primary [&_a]:underline-offset-4 hover:[&_a]:underline [&_table]:w-full [&_table]:text-sm [&_th]:border-b [&_th]:border-border [&_th]:p-2 [&_th]:text-left [&_td]:border-b [&_td]:border-border/50 [&_td]:p-2"
    >
      <Content />
    </div>
  </article>
</Base>
