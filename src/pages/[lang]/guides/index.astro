---
import { getCollection } from 'astro:content'
import Base from '@/layouts/Base.astro'
import { getDict, localizePath, LOCALES, isLocale, type Locale } from '@/i18n'

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }))
}

const lang = Astro.params.lang
const locale: Locale = isLocale(lang) ? lang : 'en'
const dict = getDict(locale)

const guides = (await getCollection('guides'))
  .filter((entry) => entry.id.startsWith(`${locale}/`))
  .sort((a, b) => a.data.order - b.data.order)
---

<Base locale={locale} title={dict.guides.title}>
  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <div class="mb-10">
      <h1 class="font-display text-3xl font-semibold sm:text-4xl">{dict.guides.title}</h1>
      <p class="mt-3 max-w-xl text-muted-foreground">{dict.guides.subtitle}</p>
    </div>
    <div class="flex flex-col gap-3">
      {
        guides.map((guide, i) => (
          <a
            href={localizePath(`/guides/${guide.id.replace(`${locale}/`, '')}`, locale)}
            class="group flex animate-rise items-center justify-between gap-4 rounded-xl border border-border bg-card p-5 transition-all hover:border-primary/40 hover:shadow-glow"
            style={`animation-delay: ${i * 60}ms`}
          >
            <div>
              <h2 class="font-display font-semibold group-hover:text-primary">
                {guide.data.title}
              </h2>
              <p class="mt-1 text-sm text-muted-foreground">{guide.data.description}</p>
            </div>
            <span class="shrink-0 text-xs text-muted-foreground">
              {dict.guides.minRead(guide.data.minutes)}
            </span>
          </a>
        ))
      }
    </div>
  </section>
</Base>
