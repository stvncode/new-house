---
import Base from '@/layouts/Base.astro'
import PlannerApp from '@/components/planner/PlannerApp'
import { getDict, LOCALES, isLocale, type Locale } from '@/i18n'

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }))
}

const lang = Astro.params.lang
const locale: Locale = isLocale(lang) ? lang : 'en'
const dict = getDict(locale)
---

<Base locale={locale} title={dict.planner.title}>
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="mb-8">
      <h1 class="font-display text-3xl font-semibold sm:text-4xl">{dict.planner.title}</h1>
      <p class="mt-2 text-muted-foreground">{dict.planner.subtitle}</p>
    </div>
    <PlannerApp client:only="react" locale={locale} />
  </section>
</Base>
