---
import '@/styles/global.css'
import Header from '@/components/site/Header.astro'
import Footer from '@/components/site/Footer.astro'
import { getDict, type Locale } from '@/i18n'

interface Props {
  locale: Locale
  title?: string
  description?: string
}

const { locale, title, description } = Astro.props
const dict = getDict(locale)
const pageTitle = title ? `${title} · ${dict.site.name}` : `${dict.site.name} — ${dict.site.tagline}`
const pageDescription = description ?? dict.home.heroSubtitle
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href={new URL(Astro.url.pathname.replace(/^\/(en|fr)/, '/en'), Astro.site ?? Astro.url)} />
    <link rel="alternate" hreflang="fr" href={new URL(Astro.url.pathname.replace(/^\/(en|fr)/, '/fr'), Astro.site ?? Astro.url)} />
  </head>
  <body class="flex min-h-svh flex-col">
    <Header locale={locale} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
