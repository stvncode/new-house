---
import { getDict, localizePath, switchLocalePath, LOCALES, type Locale } from '@/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const dict = getDict(locale)
const path = Astro.url.pathname

const links = [
  { href: localizePath('/wizard', locale), label: dict.site.nav.wizard },
  { href: localizePath('/planner', locale), label: dict.site.nav.planner },
  { href: localizePath('/guides', locale), label: dict.site.nav.guides },
]
---

<header class="sticky top-0 z-40 border-b border-border/60 bg-background/75 backdrop-blur print:hidden">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={localizePath('/', locale)} class="flex items-center gap-2">
      <span class="flex size-7 items-center justify-center rounded-md bg-primary/15 text-primary shadow-glow">
        <!-- house-wifi -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M9.5 13.866a4 4 0 0 1 5 .01"/><path d="M12 17h.01"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M7 10.754a8 8 0 0 1 10 0"/></svg>
      </span>
      <span class="font-display text-lg font-semibold tracking-tight">{dict.site.name}</span>
    </a>

    <nav class="flex items-center gap-1 text-sm">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-md px-3 py-1.5 transition-colors hover:bg-accent hover:text-foreground',
              path.startsWith(link.href) ? 'text-foreground' : 'text-muted-foreground',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <span class="mx-1 hidden h-4 w-px bg-border sm:block"></span>
      <div class="flex items-center gap-0.5" aria-label={dict.site.language}>
        {
          LOCALES.map((l) => (
            <a
              href={switchLocalePath(path, l)}
              class:list={[
                'rounded-md px-2 py-1 text-xs uppercase transition-colors',
                l === locale
                  ? 'bg-primary/15 text-primary'
                  : 'text-muted-foreground hover:bg-accent hover:text-foreground',
              ]}
            >
              {l}
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</header>
